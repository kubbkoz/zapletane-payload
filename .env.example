# --- Payload core ---
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Database ---
# The adapter is picked in src/payload.config.ts from POSTGRES_URL:
#   POSTGRES_URL set    -> Vercel Postgres (production), migrations in src/migrations-pg
#   POSTGRES_URL unset  -> SQLite via DATABASE_URI (local dev), migrations in src/migrations
#
# SQLite (default, file based — no server required).
DATABASE_URI=file:./payload.db

# Postgres (production only — Vercel injects these; leave blank locally).
# POSTGRES_URL is the pooled connection used at runtime; POSTGRES_URL_NON_POOLING
# is the direct endpoint and is used automatically while `payload migrate` runs.
# PAYLOAD_DB_SCHEMA is the Postgres schema this app owns inside the database —
# it must match the schema baked into src/migrations-pg (currently "zapletane").
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
PAYLOAD_DB_SCHEMA=

# Seeded into a fresh Postgres database by the `seed_admin` migration in
# src/migrations-pg (skipped when unset). Production only.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Site / branding ---
COMPANY_NAME="ZAPLETANE"
SITE_NAME="ZAPLETANE"
TWITTER_CREATOR=
TWITTER_SITE=

# --- URLs ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# --- Pre-launch gate ---
# Whether the pre-launch ("Čoskoro spúšťame") page is up is a content switch,
# not an env var: Site Settings -> comingSoonEnabled in /admin (default ON, so a
# fresh deploy launches gated). COMING_SOON below is only the fallback for when
# that global cannot be read at all (database down or not migrated yet) — set it
# to 1 on a pre-launch deploy so the DB-free placeholder still covers a broken
# storefront; anything in ''/0/false/off/no counts as off.
COMING_SOON=
#
# This secret is the owner's way past the gate:
# opening https://<site>/?preview=<secret> once sets the httpOnly cookie
# `zapletane_preview` for 30 days and drops the secret from the URL, after which
# that browser sees the real storefront while everyone else still gets the
# pre-launch page. Leave it blank to disable bypassing entirely.
COMING_SOON_BYPASS=

# --- Payments ---
# Dobierka and bankový prevod need NO credentials at all — they are handled by
# the in-repo "manual" payment adapter (src/payments/manual) and configured as
# rows in the `payment-methods` collection in /admin.
#
# Comgate (platba kartou) — src/payments/comgate. The card option only appears
# in the storefront when BOTH of these are set AND an enabled `payment-methods`
# row of type `card` with gateway `comgate` exists (the seed creates it
# disabled). COMGATE_TEST=true routes to Comgate's sandbox; set it to false only
# for live traffic. Never commit real values.
# Comgate also needs its "stavová URL" (status/result push) pointed at
# https://<site>/api/comgate/status in the merchant portal.
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true

# --- Stripe (dummy values are fine for build/dev; real keys needed for checkout) ---
# Kept working for the `card` payment method with gateway=stripe. The dobierka /
# prevod / Comgate paths do not touch Stripe at all.
STRIPE_SECRET_KEY=sk_test_dummy
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_dummy

# --- Sign in with Google / Facebook (OAuth) ---
# Both providers are OFF until BOTH halves of a pair are filled in: the
# "Pokračovať cez …" button is not rendered on /login or /create-account, and
# the route handler refuses the flow. E-mail + password login is unaffected and
# always available.
#
# Register this exact redirect URI in each provider's console — it must match
# byte for byte, and it is derived from NEXT_PUBLIC_SERVER_URL above:
#   Google  -> <NEXT_PUBLIC_SERVER_URL>/api/oauth/google/callback
#   Facebook-> <NEXT_PUBLIC_SERVER_URL>/api/oauth/facebook/callback
#
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type "Web application"). Scopes used: openid, email, profile. An account
# whose e-mail Google does not report as verified is never linked to an
# existing shop account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers -> your app -> Facebook Login -> Settings -> Valid OAuth
# Redirect URIs. Permission used: `email`. A shopper who declines it gets a
# Slovak message asking them to allow it or register with an e-mail, because
# Graph omits unconfirmed addresses entirely.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- MCP (Model Context Protocol) server, served at /api/mcp ---
# Do NOT hand-fill this — run `npm run mcp:mint-key` after the dev server's
# database exists; it mints/rotates a "Claude Code dev key" record (scoped
# per src/plugins/index.ts) and writes the real value here for you.
# Never commit a real key. See MCP-PLAN.md for scope/rotation notes.
PAYLOAD_MCP_API_KEY=
