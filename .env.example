# --- Payload core ---
PAYLOAD_SECRET=change-me-to-a-long-random-string

# SQLite (default, file based — no server required).
# Swap to another adapter by changing the URI *and* the adapter in src/payload.config.ts:
#   postgres://user:pass@127.0.0.1:5432/zapletane
#   mongodb://127.0.0.1/zapletane
DATABASE_URI=file:./payload.db

# --- Site / branding ---
COMPANY_NAME="ZAPLETANE"
SITE_NAME="ZAPLETANE"
TWITTER_CREATOR=
TWITTER_SITE=

# --- URLs ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# --- Stripe (dummy values are fine for build/dev; real keys needed for checkout) ---
STRIPE_SECRET_KEY=sk_test_dummy
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_dummy
